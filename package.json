{
  "name": "svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A command-line SVG editor built with TypeScript.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build --silent && node dist/main.js",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run test:build --silent && node --test .test-dist/test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run build && npm test && npm run format:check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
